// Define process containers separately in a configuration file:
includeConfig "$projectDir/example-pipeline/containers.config"

// optionally, use 'includeConfig' to add another config file. 

plugins {
   id 'nf-azure@0.9.6'
}

azure {
    batch {
        location = 'northeurope'
        accountName = "${System.getenv('AZURE_BATCH_ACCOUNT_NAME')}"
        accountKey = "${System.getenv('AZURE_BATCH_ACCOUNT_KEY')}"
        autoPoolMode = true
        deletePoolsOnCompletion=true
    }
    storage {
        accountName = "${System.getenv('AZURE_STORAGE_ACCOUNT_NAME')}"
        accountKey = "${System.getenv('AZURE_STORAGE_ACCOUNT_KEY')}"
    }
}


profiles {
    standard {
        process {
            executor = 'local'
            withLabel: 'low' {
                memory='1G'
                cpus='1'
                time='6h'
            }
            withLabel: 'med' {
                memory='2G'
                cpus='2'
            }
            withLabel: 'high' {
                memory = '8G'
                cpus='8'
            }
        }
    }

    azure {
        process {
            executor = 'azurebatch'
        }
    }

    conda { params.enable_conda = true }

    docker {
        // Enabling docker 
        docker.enabled = true
        docker.runOptions = '-u \$(id -u):\$(id -g)'
    }

    singularity {
        // Enabling singularity
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "${System.getenv('VSC_SCRATCH')}/singularity"
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.cacheDir = "${System.getenv('VSC_SCRATCH')}/.apptainer_cache"
    }
}